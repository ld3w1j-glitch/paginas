# Segurança
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Banco de dados. Em desenvolvimento, deixe comentado para usar SQLite local.
# DATABASE_URL=postgresql://usuario:senha@host:porta/banco
# CURSO_INGLES_DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# IA opcional: Gemini
AI_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# IA opcional: Ollama local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Opcional em hospedagem com volume persistente
# PERSISTENT_STORAGE_DIR=/data/portal-cursos

# Segurança e observabilidade Level 6
LOGIN_RATE_LIMIT=5/minute
MCP_RATE_LIMIT=20/minute
AGENT_RATE_LIMIT=30/minute
# CSRF_ENABLED=0  # somente para diagnóstico local; não desative em produção
# LOG_DIR=./instance/logs
# BACKUP_DIR=./backups

# Ative somente atrás de proxy reverso confiável (ex.: plataforma de deploy conhecida).
TRUST_PROXY_HEADERS=0
